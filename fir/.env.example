# Use PostgreSQL in shared/deployed environments. SQLite is only the local demo default.
DATABASE_URL=postgresql+psycopg://mediroute:change-me@localhost:5432/mediroute
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:8000
# Read-only protected map service; do not point this at MediRoute itself.
MAP_BRIDGE_URL=http://127.0.0.1:5000
# Decision support defaults to the transparent rule-based provider. To use a real local model:
AI_PROVIDER=rule-based
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=your-installed-local-model
# Backend-only TinyFish key. Never put this in frontend files or responses.
TINYFISH_API_KEY=
# TinyFish Search/Fetch cost and availability controls.
TINYFISH_MAX_RESULTS=5
TINYFISH_SEARCH_COOLDOWN_SECONDS=900
TINYFISH_SEARCH_TIMEOUT_SECONDS=35
TINYFISH_FETCH_TIMEOUT_SECONDS=150
TINYFISH_FETCH_PAGE_TIMEOUT_MS=45000

# Emergency coordination: initial response window is always 60 server seconds.
EMERGENCY_SEARCH_RADIUS_KM=30
EMERGENCY_MAX_SEARCH_RADIUS_KM=100
AMBULANCE_GPS_MAX_AGE_SECONDS=120
HOSPITAL_AVAILABILITY_MAX_AGE_SECONDS=300
ROUTE_MAX_AGE_SECONDS=30
EMERGENCY_ALLOW_LATE_ACCEPTANCE=true
REROUTE_MIN_TIME_SAVING_MINUTES=5
REROUTE_MIN_DISTANCE_SAVING_KM=2
REROUTE_SWITCH_COST_MINUTES=1
REROUTE_NEAR_DESTINATION_MINUTES=3
REROUTE_COOLDOWN_SECONDS=30
ROUTING_OSRM_URL=https://router.project-osrm.org
OSM_OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter

# Explicit controlled-demo facilities; excluded from real requests.
MEDIROUTE_DEMO_COORDINATION=false
# MEDIROUTE_DEMO_PASSWORD=<development demo password; existing accounts are not reset>
# Coordinates apply on initial creation; never track/move with the user.
DEMO_JS_HOSPITAL_LAT=27.652
DEMO_JS_HOSPITAL_LNG=77.558

# The current external map service lacks a versioned destination update API.
# Leave disabled until the documented compatible adapter is deployed.
MAP_DESTINATION_UPDATE_ENABLED=false
# MAP_BRIDGE_TOKEN=<backend-to-backend adapter secret>
