# Use PostgreSQL in shared/deployed environments. SQLite is only the local demo default.
DATABASE_URL=postgresql+psycopg://mediroute:change-me@localhost:5432/mediroute
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:8000
# Read-only protected map service; do not point this at MediRoute itself.
MAP_BRIDGE_URL=http://127.0.0.1:5000
# Decision support defaults to the transparent rule-based provider. To use a real local model:
AI_PROVIDER=rule-based
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=your-installed-local-model
